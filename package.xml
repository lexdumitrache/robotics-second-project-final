<?xml version="1.0"?>
<package format="2">
  <name>second_project</name>
  <version>1.0.0</version>
  <description>Mapping from a recorded bag and Stage/move_base navigation of an AgileX Scout Mini (Politecnico di Milano Robotics, second project)</description>

  <maintainer email="alexandradumitrachee@gmail.com">Alexandra Dumitrache</maintainer>
  <license>Unlicensed</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>actionlib</depend>
  <depend>move_base_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>tf</depend>

  <!-- task_one / gmapping_mapping: mapping from the bag -->
  <exec_depend>rosbag</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>gmapping</exec_depend>
  <!-- task_two: simulation and navigation -->
  <exec_depend>stage_ros</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz</exec_depend>

  <test_depend>rosunit</test_depend>
</package>
